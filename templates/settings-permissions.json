{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git cat-file:*)",
      "Bash(python3 scripts/commit_paths.py:*)"
    ],
    "ask": [
      "Bash(python3 scripts/commit_paths.py lease * --force*)",
      "Bash(python3 scripts/commit_paths.py lease * --release*)",
      "Bash(python3 scripts/commit_paths.py --no-role*)",
      "Bash(python3 scripts/commit_paths.py * --no-role*)",
      "Bash(git config:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote add:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rm:*)",
      "Bash(git remote rename:*)",
      "Bash(git clone:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh release:*)",
      "Bash(gh gist:*)",
      "Bash(curl * -d*)",
      "Bash(curl * --data*)",
      "Bash(curl * -X POST*)",
      "Bash(npm publish:*)",
      "Bash(twine upload:*)",
      "mcp__<server>__<tool that writes outside the project>"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git --no-pager push:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git add .:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git --no-pager rm:*)",
      "Bash(git checkout:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --force:*)",
      "Bash(git tag -d:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git-filter-repo:*)",
      "Bash(*git_filter_repo*)",
      "Bash(bfg:*)",
      "Bash(java -jar *bfg*)",
      "Bash(*<publish script>*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc:*)",
      "Bash(git prune:*)",
      "Bash(git update-ref:*)",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -rF:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm --recursive:*)",
      "Bash(/bin/rm:*)",
      "Bash(find * -delete*)",
      "Bash(rm *<raw-data path>*)",
